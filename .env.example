# Local URL used by Google OAuth redirects.
MILLOIN_BASE_URL=http://localhost:3000

# Restrict organizer access to this one Google account.
MILLOIN_OWNER_EMAIL=you@example.com

# Generate with: openssl rand -base64 48
MILLOIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Optional: bearer credential for your own AI/automation clients.
# Generate with: openssl rand -base64 48
MILLOIN_OWNER_API_KEY=

# Fast local mode: keep all poll data in process memory.
MILLOIN_STORAGE=memory

# For Firestore or its emulator instead of in-memory storage:
# MILLOIN_STORAGE=firestore
# GOOGLE_CLOUD_PROJECT=demo-milloin
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
