{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milloin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "milloin-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "TURNSTILE_SECRET_KEY": ""
  }
}
