# Copy to terraform.tfvars for local apply. Do not commit terraform.tfvars.
project_id = "your-globally-unique-gcp-project-id"
region     = "europe-north1"

# Personal service cost guardrail.
max_instances = 3

# Optional: receive uptime incidents by email.
# operator_email = "you@example.com"

# Optional: create a project-scoped monthly Cloud Billing budget.
# The currency must match the billing account, so there is intentionally no guessed default.
# billing_account_id   = "000000-000000-000000"
# budget_currency_code = "EUR"
# monthly_budget_units = 10
